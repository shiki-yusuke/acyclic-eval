{
  "name": "acyclic-eval",
  "version": "0.1.4",
  "description": "Evaluate LLM and rule-based judges with mutation cases whose generation does not depend on the judge under test.",
  "keywords": [
    "llm-evaluation",
    "llm-as-a-judge",
    "mutation-testing",
    "evaluation-framework",
    "ai-agents",
    "testing",
    "typescript",
    "cli",
    "local-first"
  ],
  "license": "MIT",
  "author": "Yusuke Shiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiki-yusuke/acyclic-eval.git"
  },
  "homepage": "https://github.com/shiki-yusuke/acyclic-eval#readme",
  "bugs": {
    "url": "https://github.com/shiki-yusuke/acyclic-eval/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "acyclic-eval": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "example": "npm run build && node dist/examples/toy/run.js",
    "demo": "npm run build && ./scripts/demo.sh",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/check-readme-sync.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:docs && npm run verify:package"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.10"
  }
}
