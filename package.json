{
  "name": "acyclic-eval",
  "version": "0.2.1",
  "description": "Evaluate LLM and rule-based judges with mutation cases whose generation does not depend on the judge under test.",
  "keywords": [
    "llm-evaluation",
    "llm-as-a-judge",
    "mutation-testing",
    "evaluation-framework",
    "ai-agents",
    "testing",
    "typescript",
    "cli",
    "local-first"
  ],
  "license": "MIT",
  "author": "Yusuke Shiki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiki-yusuke/acyclic-eval.git"
  },
  "homepage": "https://github.com/shiki-yusuke/acyclic-eval#readme",
  "bugs": {
    "url": "https://github.com/shiki-yusuke/acyclic-eval/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "acyclic-eval": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.{js,d.ts}",
    "dist/examples/toy/**/*.{js,d.ts}",
    "dist/examples/rule-based-judge/**/*.{js,d.ts}",
    "dist/examples/llm-judge-adapter/**/*.{js,d.ts}"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node18": "tsc --noEmit -p tsconfig.build.json --typeRoots ./node_modules/@node18-compat --types node --skipLibCheck false",
    "test": "npm run typecheck && vitest run --dir test",
    "test:watch": "vitest --dir test",
    "example": "npm run build && node dist/examples/toy/run.js",
    "demo": "npm run build && ./scripts/demo.sh",
    "check:docs": "node scripts/check-doc-links.mjs && node scripts/check-readme-sync.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:docs && npm run verify:package"
  },
  "devDependencies": {
    "@node18-compat/node": "npm:@types/node@18.19.130",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  }
}
